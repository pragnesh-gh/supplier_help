{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:supplier-help:research-dossier:v1",
  "title": "Supplier research dossier v1",
  "description": "Portable research snapshot. Qualitative findings never populate synthetic catalog scores. Additional fields permit forward-compatible provenance metadata.",
  "type": "object",
  "required": ["id", "status", "company", "country", "website", "scope", "mode", "demo", "created_at", "entity", "plan", "events", "sources", "findings", "categories", "gaps", "actions", "summary", "limitations", "legacy_scores"],
  "properties": {
    "schema_version": {"const": "research-dossier-v1"},
    "id": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
    "status": {"enum": ["queued", "researching", "completed", "failed"]},
    "company": {"type": "string", "minLength": 1},
    "country": {"type": "string", "description": "User-supplied hint, not independently established nationality or facility location."},
    "website": {"type": "string"},
    "scope": {"type": "string"},
    "mode": {"enum": ["basic", "deep"]},
    "demo": {"type": "boolean"},
    "created_at": {"type": "string"},
    "completed_at": {"type": "string"},
    "entity": {"type": "object", "properties": {"requested_name": {"type": "string"}, "verification": {"type": "string"}}, "required": ["requested_name", "verification"]},
    "plan": {"type": "array", "items": {"type": "object", "required": ["category", "questions"], "properties": {"category": {"$ref": "#/$defs/categoryId"}, "questions": {"type": "array", "items": {"type": "string"}}}}},
    "events": {"type": "array", "items": {"type": "object", "required": ["at", "stage", "message"], "properties": {"at": {"type": "string"}, "stage": {"type": "string"}, "message": {"type": "string"}}}},
    "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "categories": {"type": "array", "maxItems": 6, "items": {"type": "object", "required": ["id", "label", "assessment", "confidence", "summary", "finding_ids", "gaps"], "properties": {"id": {"$ref": "#/$defs/categoryId"}, "label": {"type": "string"}, "assessment": {"type": "string"}, "confidence": {"$ref": "#/$defs/confidence"}, "summary": {"type": "string"}, "finding_ids": {"type": "array", "items": {"type": "string"}}, "gaps": {"type": "array", "items": {"type": "string"}}}}},
    "gaps": {"type": "array", "items": {"type": "string"}},
    "actions": {"type": "array", "items": {"$ref": "#/$defs/action"}},
    "summary": {"type": "string"},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "legacy_scores": {"type": "null", "description": "Intentionally unknown. Never infer a 0–100 score from synthetic patterns or absence of findings."},
    "error": {"type": "string"}
  },
  "$defs": {
    "categoryId": {"enum": ["financial", "legal", "country", "people_safety", "operations", "reputation"]},
    "confidence": {"enum": ["low", "medium", "high"]},
    "source": {
      "type": "object", "required": ["id", "title", "url", "publisher", "published_at", "accessed_at", "excerpt", "kind"],
      "properties": {
        "id": {"type": "string", "pattern": "^S[0-9]+$"},
        "title": {"type": "string"}, "url": {"type": "string", "pattern": "^https?://"},
        "publisher": {"type": "string"}, "published_at": {"type": ["string", "null"]},
        "accessed_at": {"type": "string"}, "excerpt": {"type": "string"},
        "kind": {"enum": ["retrieved_excerpt", "saved_fixture_summary"]},
        "verification": {"type": "string"}
      }
    },
    "finding": {
      "type": "object", "required": ["id", "category", "title", "detail", "source_ids", "severity", "confidence", "status", "follow_up"],
      "properties": {
        "id": {"type": "string", "pattern": "^F[0-9]+$"}, "category": {"$ref": "#/$defs/categoryId"},
        "title": {"type": "string"}, "detail": {"type": "string"},
        "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "severity": {"enum": ["low", "moderate", "high", "critical", "unknown"]},
        "confidence": {"$ref": "#/$defs/confidence"},
        "status": {"enum": ["disclosed", "alleged", "unknown"]},
        "follow_up": {"type": "string"},
        "evidence": {"type": "array", "items": {"type": "object", "required": ["source_id", "quote"], "properties": {"source_id": {"type": "string"}, "quote": {"type": "string"}}}}
      }
    },
    "action": {
      "type": "object", "required": ["id", "category", "action", "priority", "status", "owner"],
      "properties": {
        "id": {"type": "string", "pattern": "^A[0-9]+$"}, "category": {"$ref": "#/$defs/categoryId"},
        "action": {"type": "string"}, "priority": {"enum": ["normal", "high"]},
        "status": {"enum": ["open", "done"]}, "owner": {"type": "string"}, "finding_id": {"type": "string"}
      }
    }
  }
}
