# Server-side only. Never embed credentials in HTML or browser JavaScript.
OPENROUTER_API_KEY=
# User confirmed Nemotron family; this model is the selected initial candidate.
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Prototype never calls these services.
APP_MODE=deterministic-prototype
# Optional future Jev via OpenRouter uses OPENROUTER_API_KEY too.
# No OpenAI Decisions integration or separate TypeSafe key is needed for this plan.
